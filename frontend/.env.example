# backend base URL, baked in at BUILD time (CRA convention - anything
# without the REACT_APP_ prefix is dropped from the bundle, and changing
# this after a build requires rebuilding, not just redeploying).
#
# local dev: leave unset, defaults to http://localhost:8420
# on Vercel: set to the deployed backend's URL, e.g.
#   REACT_APP_API_BASE=https://<your-railway-app>.up.railway.app
REACT_APP_API_BASE=
